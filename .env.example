# Kognition environment template.
#
# Copy to `.env` at the repo root and fill in your values:
#     Copy-Item .env.example .env
#
# `.env` is gitignored — never commit real secrets. The values here are read by
# `make foundry-creds` to create the `foundry-creds` SecretRef used by the
# Model Gateway and KB ingester. Sample installers also read the deployment
# settings below and preserve Kubernetes aliases while configuring Azure.
# The same service principal uses Entra authentication for Azure Blob reads.

# ---------------------------------------------------------------------------
# Azure service principal (Entra ID)
# ---------------------------------------------------------------------------
# Use deploy/azure-samples/Configure.ps1 after reviewing its subscription and
# resource parameters. It grants inference at Foundry account scope and Blob
# read access at sample-container scope, without subscription-wide runtime RBAC.
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_SECRET=your-client-secret
# The setup script records the credential's expiry here.
# AZURE_CLIENT_SECRET_EXPIRES_ON=2027-01-01T00:00:00Z

# Optional. Auth mode for the SP. One of: client-secret (default),
# workload-identity, managed-identity, default.
# AZURE_CREDENTIAL_TYPE=client-secret

# ---------------------------------------------------------------------------
# Microsoft Foundry (used by the sample Models)
# ---------------------------------------------------------------------------
# The Foundry project endpoint and the chat + embedding deployment names. The
# sample Models reference these; the SP above must have access to the project.
MS_FOUNDRY_PROJECT_ENDPOINT=https://YOUR-RESOURCE.services.ai.azure.com/api/projects/YOUR-PROJECT
MS_FOUNDRY_MODEL=your-chat-deployment
MS_FOUNDRY_INVOCATION_CONTRACT=openai-tool-chat-v1
MS_FOUNDRY_EMBEDDING_MODEL=text-embedding-3-small
# Optional explicit inference endpoint and REST API versions.
# MS_FOUNDRY_INFERENCE_ENDPOINT=https://YOUR-RESOURCE.cognitiveservices.azure.com
# MS_FOUNDRY_API_VERSION=2024-12-01-preview
# MS_FOUNDRY_EMBEDDING_API_VERSION=2024-02-01

# Populated by Configure.ps1 / samples-provision-azure for the real Blob sample.
# KOGNITION_AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
# KOGNITION_AZURE_LOCATION=eastus2
# KOGNITION_AZURE_BLOB_ACCOUNT=yourstorageaccount
# KOGNITION_AZURE_BLOB_RESOURCE_GROUP=your-sample-resource-group
# KOGNITION_AZURE_BLOB_CONTAINER=product-docs
# KOGNITION_AZURE_BLOB_PREFIX=mark7
# KOGNITION_AZURE_BLOB_DATA_PLANE_STATUS=pending-private-connectivity
