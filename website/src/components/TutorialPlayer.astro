import { site } from '../../site.mjs';
import { formatTime, tutorial, tutorialPaths } from '../../tutorial.mjs';

const media = tutorialPaths(site.base);
---

<section class="tutorial-player" aria-labelledby="watch-tutorial" data-duration={tutorial.durationSeconds}>
  <h2 id="watch-tutorial">Watch the tutorial</h2>
  <p id="tutorial-video-description">
    {formatTime(tutorial.durationSeconds)} with English captions visible in the video.
    Choose a chapter to seek without starting playback.
  </p>
  <video id="tutorial-video" controls playsinline preload="none" poster={media.poster} aria-describedby="tutorial-video-description">
    <source src={media.video} type="video/mp4" />
    <track kind="captions" src={media.captions} srclang="en" label="English text captions (optional)" />
    <track kind="chapters" src={media.chapters} srclang="en" label="Chapters" />
    <p>Your browser does not support this player. <a href={media.video}>Download the video</a> instead.</p>
  </video>
  <p class="tutorial-status" role="status" aria-live="polite" hidden></p>
  <p class="tutorial-downloads">
    <a href={media.video} download>Download MP4 ({Math.ceil(tutorial.assets.video.bytes / 1024 / 1024)} MiB)</a>
    <a href={media.subtitles} download>English captions (SRT)</a>
    <a href={media.captions} download>English captions (WebVTT)</a>
    <a href="#transcript">Read the transcript</a>
  </p>
  <nav aria-labelledby="tutorial-chapters">
    <h3 id="tutorial-chapters">Chapters</h3>
    <ol>
      {tutorial.chapters.map((chapter) => (
        <li>
          <a href="#tutorial-video" data-tutorial-time={chapter.startSeconds}>
            <span class="chapter-time">{formatTime(chapter.startSeconds)}</span>
            {chapter.title}
          </a>
        </li>
      ))}
    </ol>
  </nav>
  <noscript>Use the player's timeline to select a chapter. Chapter shortcuts require JavaScript.</noscript>
</section>

<script>
  const initialized = new WeakSet<Element>();
  function initializeTutorial() {
    const root = document.querySelector<HTMLElement>('.tutorial-player');
    if (!root || initialized.has(root)) return;
    initialized.add(root);
    const video = root.querySelector<HTMLVideoElement>('video');
    const status = root.querySelector<HTMLElement>('.tutorial-status');
    if (!video || !status) return;
    let pendingTime: number | null = null;
    const notify = (message: string) => {
      status.textContent = message;
      status.hidden = !message;
    };
    const seek = () => {
      if (pendingTime === null) return;
      if (!Number.isFinite(video.duration) || pendingTime >= video.duration) {
        notify('This chapter is outside the loaded video. Use the download links or report the media mismatch.');
        pendingTime = null;
        return;
      }
      video.currentTime = pendingTime;
      pendingTime = null;
      notify('');
      video.focus();
    };
    const requestSeek = (seconds: number) => {
      if (!Number.isFinite(seconds) || seconds < 0 || seconds >= Number(root.dataset.duration)) {
        notify('The requested tutorial timestamp is invalid.');
        return;
      }
      pendingTime = seconds;
      if (video.readyState >= HTMLMediaElement.HAVE_METADATA) seek();
      else {
        notify('Loading the selected chapter...');
        video.preload = 'metadata';
        video.load();
      }
    };
    video.addEventListener('loadedmetadata', seek);
    video.addEventListener('error', () => notify('The tutorial video could not be loaded. Try the MP4 download link or read the transcript below.'));
    video.querySelector('source')?.addEventListener('error', () =>
      notify('The tutorial video could not be loaded. Try the MP4 download link or read the transcript below.'));
    root.querySelectorAll<HTMLAnchorElement>('[data-tutorial-time]').forEach((link) => {
      link.addEventListener('click', (event) => {
        event.preventDefault();
        const seconds = Number(link.dataset.tutorialTime);
        history.replaceState(null, '', `#t=${seconds}`);
        requestSeek(seconds);
      });
    });
    const timestamp = /^#t=([0-9]+(?:\.[0-9]+)?)$/.exec(location.hash);
    if (timestamp) requestSeek(Number(timestamp[1]));
  }
  initializeTutorial();
  document.addEventListener('astro:page-load', initializeTutorial);
</script>

<style>
  .tutorial-player { margin-bottom: 2rem; }
  video { display: block; width: 100%; aspect-ratio: 16 / 9; background: #070b10; border-radius: 0.4rem; }
  .tutorial-downloads { display: flex; flex-wrap: wrap; gap: 0.5rem 1.2rem; }
  .chapter-time { display: inline-block; min-width: 3.5rem; font-variant-numeric: tabular-nums; }
  .tutorial-status { padding: 0.75rem; border: 1px solid var(--sl-color-orange); border-radius: 0.4rem; }
  a:focus-visible, video:focus-visible { outline: 2px solid var(--sl-color-text-accent); outline-offset: 3px; }
</style>
