set -euo pipefail

MSG_FILE="${1:-}"
if [[ -z "${MSG_FILE}" ]] || [[ ! -f "${MSG_FILE}" ]]; then
  echo "commit-msg hook requires the commit message file path."
  exit 1
fi

SUBJECT="$(head -n 1 "${MSG_FILE}" | tr -d '\r')"

if [[ "${SUBJECT}" =~ ^Merge\  ]] || [[ "${SUBJECT}" =~ ^Revert\  ]]; then
  exit 0
fi

if [[ ! "${SUBJECT}" =~ ^T-[0-9]{4}([[:space:]:-]|$) ]]; then
  echo "Invalid commit message: '${SUBJECT}'"
  echo "Expected format: starts with T-nnnn (example: T-0001: implement API server)"
  exit 1
fi
