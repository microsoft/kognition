# Normalize line endings to LF for all text files in the repository.
# Prevents CRLF churn on Windows checkouts and keeps `gofmt`/`buf`/shell
# scripts byte-identical across platforms and CI.
* text=auto eol=lf

# Explicit source types (belt-and-suspenders; covered by `* text=auto` above).
*.go      text eol=lf
*.mod     text eol=lf
*.sum     text eol=lf
*.py      text eol=lf
*.sh      text eol=lf
*.yaml    text eol=lf
*.yml     text eol=lf
*.json    text eol=lf
*.md      text eol=lf
*.proto   text eol=lf
Makefile  text eol=lf

# Windows-only scripts keep CRLF so they run under PowerShell/cmd natively.
*.ps1     text eol=crlf
*.cmd     text eol=crlf
*.bat     text eol=crlf

# Binary assets — never touch.
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.ico     binary
*.pdf     binary
*.gz      binary
*.zip     binary
