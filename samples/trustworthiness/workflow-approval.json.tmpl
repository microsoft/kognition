{
  "apiVersion": "kognition.dev/v1alpha1",
  "kind": "Workflow",
  "metadata": {
    "name": "trust-demo-approval",
    "namespace": "${NAMESPACE}",
    "labels": {
      "app.kubernetes.io/part-of": "trustworthiness",
      "kognition.dev/demo-run": "${DEMO_RUN_ID}"
    }
  },
  "spec": {
    "steps": [
      {
        "name": "prepared",
        "type": "tool",
        "agentRef": { "name": "tool-e2e-agent" },
        "toolRef": { "name": "tool-e2e-timestamp" },
        "input": "{}"
      },
      {
        "name": "publish",
        "type": "tool",
        "agentRef": { "name": "tool-e2e-agent" },
        "toolRef": { "name": "trust-demo-publish" },
        "input": "{\"runID\":\"${DEMO_RUN_ID}\",\"content\":\"Approved customer advisory for ${DEMO_RUN_ID}\"}"
      }
    ],
    "edges": [
      { "from": "prepared", "to": "publish" }
    ],
    "approvalGates": [
      {
        "from": "prepared",
        "to": "publish",
        "requiredApprovers": 1,
        "timeout": "5m"
      }
    ]
  }
}
